# Vite variables are public runtime configuration; never put secrets here.
VITE_API_BASE=/api
VITE_GATEWAY=http://localhost:8080
# 登录/注册时带给网关的客户端标识，必须与后端 sys_client 表里的记录一致
# （取值见 vidora-cloud/SQL/01_user_service.sql 的种子数据）。
# 不设则回落到 src/api/auth.js 里写死的 vidora-web-2024；
# 只有换了一份 sys_client 种子（比如重新初始化库、或部署环境用了别的 clientKey）才必须显式配置。
VITE_CLIENT_ID=vidora-web-2024

